{{- /* chezmoi:modify-template */ -}}
{{- /* 只合併 statusLine、theme，其餘設定保留各電腦原值 */ -}}
{{- $s := dict -}}
{{- if .chezmoi.stdin -}}{{- $s = fromJson .chezmoi.stdin -}}{{- end -}}
{{- $home := .chezmoi.homeDir | replace "\\" "/" -}}
{{- $s = setValueAtPath "statusLine" (dict "type" "command" "command" (printf "%s/AppData/Local/Python/bin/python -X utf8 %s/.claude/statusline.py" $home $home)) $s -}}
{{- $s = setValueAtPath "theme" "custom:solarized-light" $s -}}
{{- toPrettyJson "  " $s }}
